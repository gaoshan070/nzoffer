{
  "defaultSeverity": "error",
  "extends": [
    "tslint-config-airbnb",
    "tslint-react",
    "tslint-config-prettier"
  ],
  "jsRules": {},
  "rules": {
    "variable-name": [
      true,
      "ban-keywords",
      "check-format",
      "allow-pascal-case"
    ],
    "prefer-template": [true, "allow-single-concat"],
    "jsx-boolean-value": ["never"],
    "import-name": false,
    "function-name": false,
    "jsx-no-lambda": false,
    "object-shorthand-properties-first": false
  },
  "rulesDirectory": []
}
