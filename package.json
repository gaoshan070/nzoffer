  "contributors": [],
  "bugs": {},
  "directories": {
    "lib": "server",
    "test": "test/",
    "config": "config/"
  },
  "engines": {
    "node": "^10.0.0",
    "npm": ">= 6.4.1"
  },
  "scripts": {
    "test": "npm run eslint && NODE_ENV= npm run jest",
    "eslint": "eslint server/. test/. --config .eslintrc.json",
    "dev": "nodemon server/",
    "start:dev": "node server/",
    "start": "pm2-runtime start ecosystem.config.js --env production",
    "jest": "jest",
    "heroku-postbuild": "cd client && npm i && npm run build && cd .. && rm -rf ./public && mv ./client/build ./public",
    "deploy": "git push offer111 master"
  },
  "prettier": {
    "trailingComma": "all",
    "printWidth": 55,
    "singleQuote": true
  },
  "dependencies": {
    "@feathersjs/configuration": "^2.0.6",
    "@feathersjs/errors": "^3.3.6",
    "@feathersjs/express": "^1.3.1",
    "@feathersjs/feathers": "^3.3.1",
    "compression": "^1.7.3",
    "cors": "^2.8.5",
    "feathers-mongoose": "^7.3.0",
    "helmet": "^3.15.0",
    "mongodb-core": "^3.1.11",
    "mongoose": "^5.4.7",
    "pm2": "^3.2.9",
    "serve-favicon": "^2.5.0",
    "winston": "^3.2.0"
  },
  "devDependencies": {
    "eslint": "^5.12.1",
    "jest": "^24.0.0",
    "nodemon": "^1.18.9",
    "request": "^2.88.0",
    "request-promise": "^4.2.2"
  }
