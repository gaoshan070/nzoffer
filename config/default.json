{
  "host": "localhost",
  "port": 3030,
  "public": "../public/",
  "paginate": {
    "default": 90,
    "max": 100
  },
  "mongodb": "mongodb://localhost:27017/offer_111",
  "authentication": {
    "secret": "",
    "strategies": ["jwt", "local"],
    "path": "/api/authentication",
    "service": "api/user",
    "jwt": {
      "header": {
        "typ": "access"
      },
      "audience": "https://offer111.com",
      "subject": "anonymous",
      "issuer": "offer111",
      "algorithm": "HS256",
      "expiresIn": "120d"
    },
    "local": {
      "entity": "user",
      "usernameField": "phone",
      "passwordField": "password"
    }
  }
}
