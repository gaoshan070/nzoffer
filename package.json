{
  "name": "offer-111",
  "description": "web app",
  "version": "0.0.0",
  "homepage": "",
  "main": "server",
  "keywords": [
    "feathers"
  ],
  "author": {
    "name": "Albert",
    "email": "albertgaohy@gmail.com"
  },
  "contributors": [],
  "bugs": {},
  "directories": {
    "lib": "server",
    "test": "test/",
    "config": "config/"
  },
  "engines": {
    "node": "^10.0.0",
    "npm": ">= 6.4.1"
  },
  "scripts": {
    "test": "npm run eslint && NODE_ENV= npm run jest",
    "eslint": "eslint server/. test/. --config .eslintrc.json",
    "dev": "nodemon server/",
    "start:dev": "node server/",
    "start:dev:debug": "DEBUG=* node server/",
    "start": "pm2-runtime start ecosystem.config.js --env production",
    "jest": "jest",
    "pre-deploy": "cd client/ && npm run build && cd .. && rm -rf ./public/ && mv ./client/build ./public",
    "deploy": "cd client/ && npm run build && cd .. && rm -rf ./public/ && mv ./client/build ./public && git add -A && git commit -m 'deploy to production' && git push offer111 master",
    "formatAllCode": "./node_modules/.bin/prettier --parser typescript --write './server/**/*.js'"
  },
  "prettier": {
    "trailingComma": "all",
    "printWidth": 55,
    "singleQuote": true
  },
  "dependencies": {
    "@feathersjs/authentication": "^2.1.16",
    "@feathersjs/authentication-jwt": "^2.0.10",
    "@feathersjs/authentication-local": "^1.2.9",
    "@feathersjs/configuration": "^2.0.6",
    "@feathersjs/errors": "^3.3.6",
    "@feathersjs/express": "^1.3.1",
    "@feathersjs/feathers": "^3.3.1",
    "compression": "^1.7.3",
    "cors": "^2.8.5",
    "feathers-hooks-common": "^4.20.2",
    "feathers-mongoose": "^7.3.1",
    "helmet": "^3.15.1",
    "mongodb-core": "^3.1.11",
    "mongoose": "^5.4.11",
    "pm2": "^3.2.9",
    "serve-favicon": "^2.5.0",
    "winston": "^3.2.1"
  },
  "devDependencies": {
    "eslint": "^5.13.0",
    "jest": "^24.1.0",
    "nodemon": "^1.18.10",
    "prettier": "^1.16.4",
    "request": "^2.88.0",
    "request-promise": "^4.2.2"
  }
}
