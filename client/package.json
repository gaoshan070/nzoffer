{
  "name": "offer111-client",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@feathersjs/authentication-client": "^1.0.11",
    "@feathersjs/client": "^3.7.8",
    "@feathersjs/rest-client": "^1.4.7",
    "@types/jest": "^24.0.5",
    "@types/node": "^10.12.24",
    "@types/react": "^16.8.3",
    "@types/react-dom": "^16.8.1",
    "@types/react-router-dom": "^4.3.1",
    "@types/react-s-alert": "^1.3.2",
    "@types/styled-components": "^4.1.10",
    "@types/styled-system": "^3.2.2",
    "@types/webpack-env": "^1.13.7",
    "date-fns": "^1.29.0",
    "mobx": "^5.9.0",
    "mobx-react-lite": "^1.0.1",
    "normalize.css": "^8.0.1",
    "react": "^16.8.2",
    "react-dom": "^16.8.2",
    "react-pose": "^4.0.6",
    "react-router-dom": "^4.3.1",
    "react-s-alert": "^1.4.1",
    "react-scripts": "^2.1.4",
    "react-typing-animation": "^1.5.1",
    "smoothscroll-polyfill": "^0.4.3",
    "styled-components": "^4.1.3",
    "styled-system": "^3.2.0",
    "styled-tools": "^1.7.1",
    "typescript": "^3.3.3"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "formatAllCode": "./node_modules/.bin/prettier --parser typescript --write './src/**/*.ts' './src/**/*.tsx' './src/**/*.js'",
    "lint:css": "stylelint './src/**/*.ts' './src/**/*.tsx'",
    "lint:ts": "./node_modules/.bin/tslint --project ./tsconfig.json --format stylish",
    "bundleAnalysis": "node ./bundleAnalysis.js",
    "update": "./node_modules/.bin/npm-check -u",
    "now-build": "react-scripts build && mv build dist",
    "runLocalBuild": "npm run build && serve -s build",
    "build-on-server": "npm run build && rsync -a --delete ./build/ ../public/"
  },
  "proxy": "http://localhost:3030",
  "eslintConfig": {
    "extends": "react-app",
    "root": true
  },
  "browserslist": [
    ">0.2%",
    "not dead",
    "not ie <= 11",
    "not op_mini all"
  ],
  "prettier": {
    "trailingComma": "all",
    "singleQuote": true
  },
  "stylelint": {
    "processors": [
      "stylelint-processor-styled-components"
    ],
    "extends": [
      "stylelint-config-recommended",
      "stylelint-config-styled-components"
    ],
    "rules": {
      "property-no-vendor-prefix": [
        true,
        {
          "ignoreProperties": [
            "print-color-adjust"
          ]
        }
      ]
    }
  },
  "devDependencies": {
    "prettier": "^1.16.4",
    "stylelint": "^9.10.1",
    "stylelint-config-recommended": "^2.1.0",
    "stylelint-config-styled-components": "^0.1.1",
    "stylelint-processor-styled-components": "^1.5.1",
    "tslint": "^5.12.0",
    "tslint-config-airbnb": "^5.11.1",
    "tslint-config-prettier": "^1.18.0",
    "tslint-react": "^3.6.0",
    "webpack-bundle-analyzer": "^3.0.3"
  }
}
